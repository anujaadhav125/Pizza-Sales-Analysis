      <table>
        <view>
          <datasources>
            <datasource caption='pizza_sales' name='federated.14y3ote1ymx4ck117tntj0j1ivnj' />
          </datasources>
          <datasource-dependencies datasource='federated.14y3ote1ymx4ck117tntj0j1ivnj'>
