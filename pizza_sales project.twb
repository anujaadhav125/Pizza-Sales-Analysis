            <column caption='Total Price' datatype='real' default-format='c&quot;$&quot;#,##0.00' name='[total_price]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.14y3ote1ymx4ck117tntj0j1ivnj].[none:pizza_name:nk]'>
